rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Doubt-photo uploads: students can only write into their OWN folder
    // (path is doubts/{studentUid}/{fileName} — see ImageUpload.tsx), and
    // only images under 10MB. Any signed-in user can read any doubt image —
    // needed since a teacher/parent viewing a shared tutor session should
    // be able to see the photo the student attached.
    match /doubts/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
